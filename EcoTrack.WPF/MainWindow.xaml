<Window x:Class="EcoTrack.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EcoTrack.WPF"
        xmlns:vm="clr-namespace:EcoTrack.WPF.ViewModels"
        xmlns:models="clr-namespace:EcoTrack.Core.Models;assembly=EcoTrack.Core"
        mc:Ignorable="d"
        Title="EcoTrack - Admin Dashboard"
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Status color converter -->
        <Style x:Key="StatusBadge" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Active">
                    <Setter Property="Background" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Maintenance">
                    <Setter Property="Background" Value="#F57F17"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Inactive">
                    <Setter Property="Background" Value="#C62828"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Refresh Button Bar -->
        <Border Grid.Row="0" Padding="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding LoadDataCommand}"
                        Content="&#x21bb; Refresh Data"
                        FontSize="13"
                        Padding="16,6"
                        Background="#1565C0"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <TextBlock Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#666"
                           Text="{Binding Assets.Count, StringFormat='{}{0} asset(s) loaded'}"/>
            </StackPanel>
        </Border>

        <!-- Main Split Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Asset List -->
            <Border Grid.Column="0"
                    Background="#F5F5F5"
                    CornerRadius="6"
                    Padding="8">
                <DataGrid ItemsSource="{Binding Assets}"
                          SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Name}"
                                            Width="*"
                                            FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Serial #"
                                            Binding="{Binding SerialNumber}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Status"
                                            Binding="{Binding Status}"
                                            Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- RIGHT: Detail Panel -->
            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    Background="White"
                    CornerRadius="6"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- No selection placeholder -->
                    <TextBlock Grid.RowSpan="2"
                               Text="Select an asset from the list to view telemetry details."
                               Foreground="#999"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedAsset}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Asset Detail Header -->
                    <StackPanel Grid.Row="0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedAsset}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="{Binding SelectedAsset.Name}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#212121"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Serial:"
                                       Foreground="#888"
                                       FontSize="13"/>
                            <TextBlock Text="{Binding SelectedAsset.SerialNumber}"
                                       FontSize="13"
                                       Margin="6,0,0,0"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Created:"
                                       Foreground="#888"
                                       FontSize="13"/>
                            <TextBlock Text="{Binding SelectedAsset.CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                       FontSize="13"
                                       Margin="6,0,0,0"/>
                        </StackPanel>

                        <Border Margin="0,10,0,0">
                            <TextBlock Text="{Binding SelectedAsset.Status}"
                                       Style="{StaticResource StatusBadge}"
                                       HorizontalAlignment="Left"/>
                        </Border>

                        <TextBlock Margin="0,16,0,4"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#424242">
                            <Run Text="Telemetry History ("/>
                            <Run Text="{Binding TelemetryRecords.Count, Mode=OneWay}"/>
                            <Run Text=" records)"/>
                        </TextBlock>

                        <Separator/>
                    </StackPanel>

                    <!-- Telemetry Records Grid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding TelemetryRecords}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Margin="0,4,0,0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp"
                                                Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                                Width="170"/>
                            <DataGridTextColumn Header="Metric"
                                                Binding="{Binding MetricName}"
                                                Width="160"/>
                            <DataGridTextColumn Header="Value"
                                                Binding="{Binding MetricValue}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>