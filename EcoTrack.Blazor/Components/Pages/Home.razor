@page "/"
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory

<PageTitle>EcoTrack — Dashboard</PageTitle>

<div class="container-fluid px-0">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1 text-dark">
                <i class="bi bi-speedometer2 me-2"></i>EcoTrack Dashboard
            </h1>
            <p class="text-muted mb-0">Public telemetry monitoring — real-time overview of all tracked assets</p>
        </div>
        <button class="btn btn-primary shadow-sm" @onclick="RefreshData">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
        </button>
    </div>

    <!-- Metrics Bar -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary bg-opacity-10">
                <div class="card-body text-center py-4">
                    <i class="bi bi-boxes display-6 text-primary"></i>
                    <h2 class="fw-bold text-dark mt-2 mb-0">@_totalAssets</h2>
                    <p class="text-muted mb-0 small text-uppercase fw-semibold">Total Assets</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success bg-opacity-10">
                <div class="card-body text-center py-4">
                    <i class="bi bi-check-circle display-6 text-success"></i>
                    <h2 class="fw-bold text-dark mt-2 mb-0">@_activeAssets</h2>
                    <p class="text-muted mb-0 small text-uppercase fw-semibold">Active</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-warning bg-opacity-10">
                <div class="card-body text-center py-4">
                    <i class="bi bi-tools display-6 text-warning"></i>
                    <h2 class="fw-bold text-dark mt-2 mb-0">@_maintenanceAssets</h2>
                    <p class="text-muted mb-0 small text-uppercase fw-semibold">Maintenance</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text"
                       class="form-control border-start-0"
                       placeholder="Search assets by name or serial number..."
                       value="@SearchTerm"
                       @oninput="OnSearchInput" />
            </div>
        </div>
    </div>

    <!-- Assets Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-grid me-2"></i>Tracked Assets
                <span class="badge bg-secondary ms-2">@_filteredAssets.Count</span>
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Name</th>
                        <th>Serial Number</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Created</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_filteredAssets.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                No assets found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var asset in _filteredAssets)
                        {
                            <tr role="button"
                                @onclick="() => NavigateToAsset(asset.Id)"
                                style="cursor: pointer;">
                                <td class="ps-4 fw-semibold text-primary">@asset.Name</td>
                                <td><code class="bg-light px-2 py-1 rounded">@asset.SerialNumber</code></td>
                                <td>
                                    <span class="badge @GetStatusClass(asset.Status)">@asset.Status</span>
                                </td>
                                <td class="text-end pe-4 text-muted small">@asset.CreatedAt.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<Asset> _allAssets = new();
    private List<Asset> _filteredAssets = new();
    private string SearchTerm { get; set; } = string.Empty;
    private int _totalAssets;
    private int _activeAssets;
    private int _maintenanceAssets;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var context = scope.ServiceProvider.GetRequiredService<AppDbContext>();

        _allAssets = await context.Assets
            .AsNoTracking()
            .OrderBy(a => a.Name)
            .ToListAsync();

        _totalAssets = _allAssets.Count;
        _activeAssets = _allAssets.Count(a => a.Status == "Active");
        _maintenanceAssets = _allAssets.Count(a => a.Status == "Maintenance");

        _filteredAssets = _allAssets;
        SearchTerm = string.Empty;
    }

    private async Task RefreshData()
    {
        await LoadDataAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? string.Empty;

        _filteredAssets = string.IsNullOrWhiteSpace(SearchTerm)
            ? _allAssets
            : _allAssets
                .Where(a =>
                    a.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    a.SerialNumber.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private void NavigateToAsset(int id)
    {
        _navigationManager.NavigateTo($"/asset/{id}");
    }

    private string GetStatusClass(string status) => status switch
    {
        "Active" => "bg-success",
        "Maintenance" => "bg-warning text-dark",
        "Inactive" => "bg-danger",
        _ => "bg-secondary"
    };

    [Inject]
    private NavigationManager _navigationManager { get; set; } = null!;
}